{
  "manifest_version": 3,
  "name": "Ask Jev",
  "description": "Ask fast probabilistic questions about the page you are viewing.",
  "version": "0.2.1",
  "minimum_chrome_version": "119",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ask Jev",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "toggle-ask-jev": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+J"
      },
      "description": "Open Ask Jev on the current page"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["assets/pdf.worker.min.mjs", "assets/cmaps/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; connect-src https://api.typesafe.ai; object-src 'none'; base-uri 'none'"
  }
}
